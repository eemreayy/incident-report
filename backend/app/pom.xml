<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.emreay.incidentreport</groupId>
        <artifactId>backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <name>app</name>
    <description>Deployable bootstrap: wires the modules together into one Spring Boot application</description>

    <!--
      The only deployable artifact and the only module allowed to depend on every other module.
      It contains the @SpringBootApplication class and the application*.yml files - Spring Boot
      loads application.yml from the classpath root, so exactly one module may own it.

      Keep application logic out of here. This module wires, it does not decide.
    -->
    <dependencies>
        <dependency>
            <groupId>com.emreay.incidentreport</groupId>
            <artifactId>shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.emreay.incidentreport</groupId>
            <artifactId>ingestion</artifactId>
        </dependency>
        <dependency>
            <groupId>com.emreay.incidentreport</groupId>
            <artifactId>analysis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.emreay.incidentreport</groupId>
            <artifactId>realtime</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          API documentation generated from the controllers themselves (NFR-07). It lives here
          because `app` is the only module that sees every controller, and because a description
          that is written by hand drifts from the code it describes.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Architecture rules live here because this is the only module that sees
          every other module on its classpath. See ADR-017.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Versions come from Spring Boot's dependency management. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>incident-report</finalName>
        <plugins>
            <!--
              Project-wide coverage report. The per-module `check` in the parent is
              the gate; this produces the single number NFR-02 talks about, by
              merging the coverage of every module this one depends on - which is
              all of them. Output: app/target/site/jacoco-aggregate/index.html
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>incident-report backend coverage</title>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Only this module is repackaged into an executable jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
