<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.emreay.incidentreport</groupId>
        <artifactId>backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>realtime</artifactId>
    <name>realtime</name>
    <description>One-way Server-Sent Events broadcast of newly produced structured records</description>

    <!--
      A transport layer, not a source of truth: it owns no database and depends on no other module
      than `shared`. It learns about new records from domain events, never by querying analysis.
    -->
    <dependencies>
        <dependency>
            <groupId>com.emreay.incidentreport</groupId>
            <artifactId>shared</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The parent fails a module that runs no tests, which is what keeps the coverage gate
              from being skipped (ADR-018). This module has no production code yet - the SSE
              broadcast lands in T-18 - so there is nothing to test and nothing to skip past.

              REMOVE THIS OVERRIDE IN T-18, together with the first class that arrives here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
