<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.emreay.incidentreport</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>backend</name>
    <description>Incident reporting system - backend (modular monolith)</description>

    <!--
      Modular monolith, realised as a Maven multi-module build.

      The module graph is the architecture boundary. A module can only use types from modules it
      declares a dependency on, so "ingestion must not reach into analysis" is a compile error
      rather than a convention someone has to remember:

          shared     <- no dependency on any other module
          ingestion  -> shared
          analysis   -> shared
          realtime   -> shared
          app        -> shared, ingestion, analysis, realtime   (the only deployable artifact)

      Note there is deliberately no edge between ingestion and analysis. They communicate through
      domain events published from `shared`.
    -->
    <modules>
        <module>shared</module>
        <module>ingestion</module>
        <module>analysis</module>
        <module>realtime</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jacoco.version>0.8.15</jacoco.version>
        <archunit.version>1.5.0</archunit.version>

        <!-- NFR-02: unit test coverage must be at least 80%. This is a floor the
             build enforces, not a target to aim at. -->
        <coverage.minimum.line>0.80</coverage.minimum.line>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Own modules. Declared here so children never repeat a version. -->
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>ingestion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>analysis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>realtime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          Inherited by every module. Keep this list minimal: anything added here is something all
          modules are allowed to couple to. Module-specific libraries belong in that module's pom.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Coverage gate (NFR-02). Applied per module rather than only to a
                  project-wide total: an aggregate number lets a well-tested module
                  hide an untested one, and the requirement is that the important
                  functionality is covered, not that the average looks good.
                  The `app` module additionally produces an aggregate report for
                  reporting purposes.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <!-- Bootstrap class: main() is never exercised by tests, and
                                 wrapping it just to reach 100% would test nothing. -->
                            <exclude>**/IncidentReportApplication.class</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${coverage.minimum.line}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  Closes the hole recorded in ADR-018. JaCoCo's `check` silently skips a module
                  that produced no execution data, which is exactly what a module with code and
                  no tests looks like - so the coverage gate would wave it through. Failing the
                  build when a module runs no tests at all guarantees the execution data exists,
                  and therefore that the gate actually runs.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <failIfNoTests>true</failIfNoTests>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>enforce-build-environment</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <!--
                                      Java 21 is required as a floor (NFR-01). The ceiling is left
                                      open so the project can still be built on a newer JDK; the
                                      compiler's <release>21</release> below keeps the API surface
                                      pinned to 21 regardless. Reference/tested version: JDK 21.
                                    -->
                                    <requireJavaVersion>
                                        <version>[21,)</version>
                                        <message>Java 21 or newer is required (NFR-01). Check your JAVA_HOME.</message>
                                    </requireJavaVersion>
                                    <requireMavenVersion>
                                        <version>[3.9,)</version>
                                    </requireMavenVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Pins bytecode and API surface to 21: using a newer API breaks the build. -->
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
