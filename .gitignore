# Monorepo: this file covers every module. Patterns without a leading slash
# match at any depth, so `target/` and `node_modules/` apply under backend/
# and frontend/ alike.

### Java / Maven ###
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/timing.properties
# NOTE: mvnw, mvnw.cmd and .mvn/wrapper/maven-wrapper.properties ARE committed.
# The whole point of the wrapper is that a fresh clone builds without Maven installed.
dependency-reduced-pom.xml
buildNumber.properties
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
*.class
*.jar
*.war
hs_err_pid*
replay_pid*

### Node / frontend ###
node_modules/
dist/
build/
.next/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

### IDE ###
.idea/
*.iws
*.iml
*.ipr
out/
.vscode/
.classpath
.project
.settings/
.apt_generated
.factorypath

### macOS ###
.DS_Store
.AppleDouble
.LSOverride
._*

### Environment / secrets ###
.env
.env.*
!.env.example
*.pem
*.key

### Docker ###
docker-compose.override.yml

### Logs & test output ###
*.log
logs/
*.exec
