# Optional overrides for docker compose.
#
# You do NOT need this file to run the system: every value has an inline default,
# so `docker compose up --build` works on a fresh clone. Copy it only to change
# something:
#
#   cp .env.example .env
#
# Note: compose reads .env from the directory of the compose file being run. This
# file serves the root (full-system) compose. If you run the backend on its own
# with `cd backend && docker compose up`, put overrides in backend/.env instead.
#
# .env is git-ignored. Never commit real credentials.

# --- Application ---
APP_PORT=8080
FRONTEND_PORT=3000

# --- PostgreSQL (structured / analytical data) ---
POSTGRES_DB=incident_report
POSTGRES_USER=incident
POSTGRES_PASSWORD=incident
POSTGRES_PORT=5432

# --- MongoDB (raw report text, append-only log) ---
MONGO_DB=incident_report
MONGO_USER=incident
MONGO_PASSWORD=incident
MONGO_PORT=27017
