# Optional overrides for docker compose.
#
# You do NOT need this file to run the system: docker-compose.yml carries the same
# values as inline defaults, so `docker compose up --build` works on a fresh clone.
# Copy it to .env only when you want to change something:
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.

# --- Application ---
APP_PORT=8080

# --- PostgreSQL (structured / analytical data) ---
POSTGRES_DB=incident_report
POSTGRES_USER=incident
POSTGRES_PASSWORD=incident
POSTGRES_PORT=5432

# --- MongoDB (raw report text, append-only log) ---
MONGO_DB=incident_report
MONGO_USER=incident
MONGO_PASSWORD=incident
MONGO_PORT=27017
