<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.emreay.incidentreport</groupId>
    <artifactId>incident-report-be</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>incident-report-be</name>
    <description>Incident reporting system - backend (modular monolith)</description>

    <!--
      Modular monolith, realised as a Maven multi-module build.

      The module graph is the architecture boundary. A module can only use types from modules it
      declares a dependency on, so "ingestion must not reach into analysis" is a compile error
      rather than a convention someone has to remember:

          shared     <- no dependency on any other module
          ingestion  -> shared
          analysis   -> shared
          realtime   -> shared
          app        -> shared, ingestion, analysis, realtime   (the only deployable artifact)

      Note there is deliberately no edge between ingestion and analysis. They communicate through
      domain events published from `shared`.
    -->
    <modules>
        <module>shared</module>
        <module>ingestion</module>
        <module>analysis</module>
        <module>realtime</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Own modules. Declared here so children never repeat a version. -->
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>ingestion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>analysis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.emreay.incidentreport</groupId>
                <artifactId>realtime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          Inherited by every module. Keep this list minimal: anything added here is something all
          modules are allowed to couple to. Module-specific libraries belong in that module's pom.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>enforce-build-environment</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <!--
                                      Java 21 is required as a floor (NFR-01). The ceiling is left
                                      open so the project can still be built on a newer JDK; the
                                      compiler's <release>21</release> below keeps the API surface
                                      pinned to 21 regardless. Reference/tested version: JDK 21.
                                    -->
                                    <requireJavaVersion>
                                        <version>[21,)</version>
                                        <message>Java 21 or newer is required (NFR-01). Check your JAVA_HOME.</message>
                                    </requireJavaVersion>
                                    <requireMavenVersion>
                                        <version>[3.9,)</version>
                                    </requireMavenVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Pins bytecode and API surface to 21: using a newer API breaks the build. -->
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
